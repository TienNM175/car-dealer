generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Import all schema files
// User & Auth
model User {
  id             String    @id @default(cuid())
  email          String    @unique
  hashedPassword String    @map("hashed_password")
  firstName      String?   @map("first_name")
  lastName       String?   @map("last_name")
  phone          String?
  role           UserRole  @default(DEALER_STAFF)
  isActive       Boolean   @default(true) @map("is_active")
  
  dealerId       String?   @map("dealer_id")
  dealer         Dealer?   @relation(fields: [dealerId], references: [id])
  
  sessions       Session[]
  contracts      Contract[]
  dealerOrders   DealerOrder[]
  quotations     Quotation[]
  testDrives     TestDrive[]
  
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([dealerId])
  @@index([email])
  @@map("users")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  isActive     Boolean  @default(true) @map("is_active")
  
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("sessions")
}

enum UserRole {
  ADMIN
  EVM_STAFF
  DEALER_MANAGER
  DEALER_STAFF
}

// Dealers
model Region {
  id      String   @id @default(cuid())
  name    String   @unique
  code    String   @unique
  dealers Dealer[]
  
  @@map("regions")
}

model Dealer {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  regionId    String   @map("region_id")
  address     String?
  city        String?
  phone       String?
  email       String?
  isActive    Boolean  @default(true) @map("is_active")
  
  region          Region            @relation(fields: [regionId], references: [id])
  users           User[]
  dealerOrders    DealerOrder[]
  inventories     Inventory[]
  dealerDiscounts DealerDiscount[]
  dealerContracts DealerContract[]
  targets         Target[]
  dealerDebts     DealerDebt[]
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([regionId])
  @@map("dealers")
}

model DealerContract {
  id              String               @id @default(cuid())
  contractCode    String               @unique @map("contract_code")
  dealerId        String               @map("dealer_id")
  startDate       DateTime             @map("start_date")
  endDate         DateTime             @map("end_date")
  commissionRate  Decimal              @map("commission_rate")
  status          DealerContractStatus @default(ACTIVE)
  signedAt        DateTime?            @map("signed_at")
  
  dealer      Dealer   @relation(fields: [dealerId], references: [id])
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([dealerId])
  @@map("dealer_contracts")
}

model Target {
  id             String   @id @default(cuid())
  dealerId       String   @map("dealer_id")
  year           Int
  month          Int
  targetAmount   Decimal  @map("target_amount")
  achievedAmount Decimal  @default(0) @map("achieved_amount")
  
  dealer      Dealer   @relation(fields: [dealerId], references: [id])
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([dealerId, year, month])
  @@index([dealerId])
  @@map("targets")
}

model DealerDebt {
  id          String     @id @default(cuid())
  dealerId    String     @map("dealer_id")
  totalDebt   Decimal    @default(0) @map("total_debt")
  paidAmount  Decimal    @default(0) @map("paid_amount")
  dueDate     DateTime?  @map("due_date")
  status      DebtStatus @default(UNPAID)
  
  dealer      Dealer   @relation(fields: [dealerId], references: [id])
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([dealerId])
  @@map("dealer_debts")
}

enum DealerContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
}

enum DebtStatus {
  UNPAID
  PARTIAL
  PAID
  OVERDUE
}

// Vehicles
model Manufacturer {
  id          String    @id @default(cuid())
  name        String    @unique
  code        String    @unique
  country     String
  logo        String?
  isActive    Boolean   @default(true) @map("is_active")
  vehicles    Vehicle[]
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("manufacturers")
}

model Vehicle {
  id                String          @id @default(cuid())
  manufacturerId    String          @map("manufacturer_id")
  model             String
  variant           String?
  year              Int
  batteryCapacity   Int             @map("battery_capacity")
  range             Int
  chargingTime      Int?            @map("charging_time")
  motorPower        Int?            @map("motor_power")
  topSpeed          Int?            @map("top_speed")
  acceleration      Float?
  seats             Int             @default(5)
  doors             Int             @default(4)
  color             VehicleColor    @default(WHITE)
  bodyType          VehicleBodyType @default(SUV)
  
  wholesalePrice    Decimal         @map("wholesale_price")
  retailPrice       Decimal         @map("retail_price")
  currency          CurrencyCode    @default(USD)
  
  status            VehicleStatus   @default(ACTIVE)
  description       String?         @db.Text
  specifications    String?         @db.Text
  
  manufacturer      Manufacturer    @relation(fields: [manufacturerId], references: [id])
  images            VehicleImage[]
  evmInventories    EVMInventory[]
  dealerInventories Inventory[]
  dealerOrders      DealerOrder[]
  quotations        Quotation[]
  contracts         Contract[]
  testDrives        TestDrive[]
  
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  @@index([manufacturerId])
  @@index([status])
  @@index([retailPrice])
  @@map("vehicles")
}

model VehicleImage {
  id        String  @id @default(cuid())
  vehicleId String  @map("vehicle_id")
  url       String
  alt       String?
  blurhash  String?
  isMain    Boolean @default(false) @map("is_main")
  order     Int     @default(0)
  
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@map("vehicle_images")
}

enum VehicleColor {
  BLACK
  WHITE
  SILVER
  GREY
  RED
  BLUE
  GREEN
  YELLOW
  ORANGE
  BROWN
  GOLD
  BEIGE
  OTHER
}

enum VehicleBodyType {
  SEDAN
  SUV
  HATCHBACK
  COUPE
  WAGON
  VAN
  TRUCK
  OTHER
}

enum VehicleStatus {
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
}

enum CurrencyCode {
  USD
  EUR
  GBP
  VND
}

// Customers
model Customer {
  id            String              @id @default(cuid())
  firstName     String              @map("first_name")
  lastName      String              @map("last_name")
  email         String
  phone         String?
  address       String?
  city          String?
  identityCard  String?             @map("identity_card")
  status        CustomerStatus      @default(INTERESTED)
  
  lifecycle     CustomerLifecycle[]
  contracts     Contract[]
  quotations    Quotation[]
  testDrives    TestDrive[]
  feedbacks     Feedback[]
  complaints    Complaint[]
  customerDebts CustomerDebt[]
  
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  @@index([email])
  @@index([phone])
  @@map("customers")
}

model CustomerLifecycle {
  id          String         @id @default(cuid())
  customerId  String         @map("customer_id")
  status      CustomerStatus
  notes       String?        @db.Text
  changedBy   String?        @map("changed_by")
  
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([customerId])
  @@map("customer_lifecycle")
}

model TestDrive {
  id            String           @id @default(cuid())
  customerId    String           @map("customer_id")
  vehicleId     String           @map("vehicle_id")
  staffId       String           @map("staff_id")
  scheduledDate DateTime         @map("scheduled_date")
  status        TestDriveStatus  @default(SCHEDULED)
  notes         String?          @db.Text
  feedback      String?          @db.Text
  
  customer      Customer @relation(fields: [customerId], references: [id])
  vehicle       Vehicle  @relation(fields: [vehicleId], references: [id])
  staff         User     @relation(fields: [staffId], references: [id])
  
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([customerId])
  @@index([vehicleId])
  @@index([staffId])
  @@map("test_drives")
}

model Feedback {
  id          String           @id @default(cuid())
  customerId  String           @map("customer_id")
  contractId  String?          @map("contract_id")
  rating      Int
  comment     String?          @db.Text
  category    FeedbackCategory
  
  customer    Customer  @relation(fields: [customerId], references: [id])
  contract    Contract? @relation(fields: [contractId], references: [id])
  
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([customerId])
  @@map("feedbacks")
}

model Complaint {
  id          String          @id @default(cuid())
  customerId  String          @map("customer_id")
  contractId  String?         @map("contract_id")
  subject     String
  description String          @db.Text
  status      ComplaintStatus @default(OPEN)
  resolution  String?         @db.Text
  resolvedAt  DateTime?       @map("resolved_at")
  resolvedBy  String?         @map("resolved_by")
  
  customer    Customer  @relation(fields: [customerId], references: [id])
  contract    Contract? @relation(fields: [contractId], references: [id])
  
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([customerId])
  @@index([status])
  @@map("complaints")
}

model CustomerDebt {
  id          String     @id @default(cuid())
  customerId  String     @map("customer_id")
  contractId  String     @map("contract_id")
  totalDebt   Decimal    @map("total_debt")
  paidAmount  Decimal    @default(0) @map("paid_amount")
  dueDate     DateTime?  @map("due_date")
  status      DebtStatus @default(UNPAID)
  
  customer    Customer @relation(fields: [customerId], references: [id])
  contract    Contract @relation(fields: [contractId], references: [id])
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([customerId])
  @@index([contractId])
  @@map("customer_debts")
}

enum CustomerStatus {
  INTERESTED
  CONTACTED
  TEST_DRIVE
  QUOTED
  PURCHASED
  COLD
}

enum TestDriveStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum FeedbackCategory {
  SERVICE
  PRODUCT
  DELIVERY
  OTHER
}

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

// Orders & Sales
model Quotation {
  id          String          @id @default(cuid())
  quoteNumber String          @unique @map("quote_number")
  customerId  String          @map("customer_id")
  vehicleId   String          @map("vehicle_id")
  staffId     String          @map("staff_id")
  
  basePrice   Decimal         @map("base_price")
  discount    Decimal         @default(0)
  finalPrice  Decimal         @map("final_price")
  
  paymentType PaymentType     @default(FULL) @map("payment_type")
  installmentMonths Int?      @map("installment_months")
  monthlyPayment    Decimal?  @map("monthly_payment")
  
  validUntil  DateTime        @map("valid_until")
  status      QuotationStatus @default(DRAFT)
  notes       String?         @db.Text
  
  customer    Customer @relation(fields: [customerId], references: [id])
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])
  staff       User     @relation(fields: [staffId], references: [id])
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([customerId])
  @@index([staffId])
  @@map("quotations")
}

model Contract {
  id              String         @id @default(cuid())
  contractCode    String         @unique @map("contract_code")
  customerId      String         @map("customer_id")
  staffId         String         @map("staff_id")
  vehicleId       String         @map("vehicle_id")
  
  basePrice       Decimal        @map("base_price")
  discount        Decimal        @default(0)
  finalPrice      Decimal        @map("final_price")
  
  paymentType     PaymentType    @default(FULL) @map("payment_type")
  installmentMonths Int?         @map("installment_months")
  monthlyPayment    Decimal?     @map("monthly_payment")
  interestRate      Decimal?     @map("interest_rate")
  
  status          ContractStatus @default(DRAFT)
  signedAt        DateTime?      @map("signed_at")
  deliveryDate    DateTime?      @map("delivery_date")
  deliveredAt     DateTime?      @map("delivered_at")
  
  notes           String?        @db.Text
  
  customer        Customer       @relation(fields: [customerId], references: [id])
  staff           User           @relation(fields: [staffId], references: [id])
  vehicle         Vehicle        @relation(fields: [vehicleId], references: [id])
  feedbacks       Feedback[]
  complaints      Complaint[]
  customerDebts   CustomerDebt[]
  
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  @@index([customerId])
  @@index([staffId])
  @@index([vehicleId])
  @@map("contracts")
}

model DealerOrder {
  id           String            @id @default(cuid())
  orderNumber  String            @unique @map("order_number")
  dealerId     String            @map("dealer_id")
  staffId      String            @map("staff_id")
  vehicleId    String            @map("vehicle_id")
  quantity     Int
  unitPrice    Decimal           @map("unit_price")
  totalAmount  Decimal           @map("total_amount")
  status       DealerOrderStatus @default(PENDING)
  
  orderedAt    DateTime          @default(now()) @map("ordered_at")
  confirmedAt  DateTime?         @map("confirmed_at")
  shippedAt    DateTime?         @map("shipped_at")
  deliveredAt  DateTime?         @map("delivered_at")
  
  notes        String?           @db.Text
  
  dealer       Dealer   @relation(fields: [dealerId], references: [id])
  staff        User     @relation(fields: [staffId], references: [id])
  vehicle      Vehicle  @relation(fields: [vehicleId], references: [id])
  
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([dealerId])
  @@index([staffId])
  @@index([vehicleId])
  @@map("dealer_orders")
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum ContractStatus {
  DRAFT
  PENDING
  SIGNED
  DELIVERING
  COMPLETED
  CANCELLED
}

enum PaymentType {
  FULL
  INSTALLMENT
}

enum DealerOrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

// Inventory
model EVMInventory {
  id          String   @id @default(cuid())
  vehicleId   String   @map("vehicle_id")
  quantity    Int      @default(0)
  reserved    Int      @default(0)
  available   Int      @default(0)
  location    String?
  
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([vehicleId])
  @@index([vehicleId])
  @@map("evm_inventories")
}

model Inventory {
  id          String   @id @default(cuid())
  dealerId    String   @map("dealer_id")
  vehicleId   String   @map("vehicle_id")
  quantity    Int      @default(0)
  reserved    Int      @default(0)
  sold        Int      @default(0)
  available   Int      @default(0)
  location    String?
  
  dealer      Dealer   @relation(fields: [dealerId], references: [id])
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([dealerId, vehicleId])
  @@index([dealerId])
  @@index([vehicleId])
  @@map("inventories")
}

// Promotions
model DealerDiscount {
  id            String       @id @default(cuid())
  dealerId      String       @map("dealer_id")
  name          String
  description   String?      @db.Text
  discountType  DiscountType @default(PERCENTAGE) @map("discount_type")
  discountValue Decimal      @map("discount_value")
  minPurchase   Decimal?     @map("min_purchase")
  
  startDate     DateTime     @map("start_date")
  endDate       DateTime?    @map("end_date")
  isActive      Boolean      @default(true) @map("is_active")
  
  dealer        Dealer @relation(fields: [dealerId], references: [id])
  
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([dealerId])
  @@index([isActive])
  @@map("dealer_discounts")
}

enum DiscountType {
  PERCENTAGE
  FIXED
}