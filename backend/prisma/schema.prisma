generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Customer {
  id            String              @id @default(cuid())
  firstName     String              @map("first_name")
  lastName      String              @map("last_name")
  email         String
  phone         String?
  address       String?
  city          String?
  identityCard  String?             @map("identity_card")
  status        CustomerStatus      @default(INTERESTED)
  dealerId      String              @map("dealer_id")
  createdBy     String?             @map("created_by")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  complaints    Complaint[]
  contracts     Contract[]
  customerDebts CustomerDebt[]
  lifecycle     CustomerLifecycle[]
  dealer        Dealer              @relation(fields: [dealerId], references: [id])
  feedbacks     Feedback[]
  quotations    Quotation[]
  testDrives    TestDrive[]

  @@index([email])
  @@index([phone])
  @@index([dealerId])
  @@map("customers")
}

model CustomerLifecycle {
  id         String         @id @default(cuid())
  customerId String         @map("customer_id")
  status     CustomerStatus
  notes      String?
  changedBy  String?        @map("changed_by")
  createdAt  DateTime       @default(now()) @map("created_at")
  customer   Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_lifecycle")
}

model TestDrive {
  id            String          @id @default(cuid())
  customerId    String          @map("customer_id")
  vehicleId     String          @map("vehicle_id")
  staffId       String          @map("staff_id")
  scheduledDate DateTime        @map("scheduled_date")
  status        TestDriveStatus @default(SCHEDULED)
  notes         String?
  feedback      String?
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  customer      Customer        @relation(fields: [customerId], references: [id])
  staff         User            @relation(fields: [staffId], references: [id])
  vehicle       Vehicle         @relation(fields: [vehicleId], references: [id])

  @@index([customerId])
  @@index([vehicleId])
  @@index([staffId])
  @@map("test_drives")
}

model Feedback {
  id         String           @id @default(cuid())
  customerId String           @map("customer_id")
  contractId String?          @map("contract_id")
  rating     Int
  comment    String?
  category   FeedbackCategory
  createdAt  DateTime         @default(now()) @map("created_at")
  contract   Contract?        @relation(fields: [contractId], references: [id])
  customer   Customer         @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@map("feedbacks")
}

model Complaint {
  id          String          @id @default(cuid())
  customerId  String          @map("customer_id")
  contractId  String?         @map("contract_id")
  subject     String
  description String
  status      ComplaintStatus @default(OPEN)
  resolution  String?
  resolvedAt  DateTime?       @map("resolved_at")
  resolvedBy  String?         @map("resolved_by")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  contract    Contract?       @relation(fields: [contractId], references: [id])
  customer    Customer        @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@index([status])
  @@map("complaints")
}

model CustomerDebt {
  id         String     @id @default(cuid())
  customerId String     @map("customer_id")
  contractId String     @map("contract_id")
  totalDebt  Decimal    @map("total_debt")
  paidAmount Decimal    @default(0) @map("paid_amount")
  dueDate    DateTime?  @map("due_date")
  status     DebtStatus @default(UNPAID)
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")
  contract   Contract   @relation(fields: [contractId], references: [id])
  customer   Customer   @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@index([contractId])
  @@map("customer_debts")
}

model Region {
  id      String   @id @default(cuid())
  name    String   @unique
  code    String   @unique
  dealers Dealer[]

  @@map("regions")
}

model Dealer {
  id              String           @id @default(cuid())
  name            String
  code            String           @unique
  regionId        String           @map("region_id")
  address         String?
  city            String?
  phone           String?
  email           String?
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  customers       Customer[]
  dealerContracts DealerContract[]
  dealerDebts     DealerDebt[]
  dealerDiscounts DealerDiscount[]
  dealerOrders    DealerOrder[]
  region          Region           @relation(fields: [regionId], references: [id])
  inventories     Inventory[]
  targets         Target[]
  users           User[]

  @@index([regionId])
  @@map("dealers")
}

model DealerContract {
  id             String               @id @default(cuid())
  contractCode   String               @unique @map("contract_code")
  dealerId       String               @map("dealer_id")
  startDate      DateTime             @map("start_date")
  endDate        DateTime             @map("end_date")
  commissionRate Decimal              @map("commission_rate")
  status         DealerContractStatus @default(ACTIVE)
  signedAt       DateTime?            @map("signed_at")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  dealer         Dealer               @relation(fields: [dealerId], references: [id])

  @@index([dealerId])
  @@map("dealer_contracts")
}

model Target {
  id             String   @id @default(cuid())
  dealerId       String   @map("dealer_id")
  year           Int
  month          Int
  targetAmount   Decimal  @map("target_amount")
  achievedAmount Decimal  @default(0) @map("achieved_amount")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  dealer         Dealer   @relation(fields: [dealerId], references: [id])

  @@unique([dealerId, year, month])
  @@index([dealerId])
  @@map("targets")
}

model DealerDebt {
  id         String     @id @default(cuid())
  dealerId   String     @map("dealer_id")
  totalDebt  Decimal    @default(0) @map("total_debt")
  paidAmount Decimal    @default(0) @map("paid_amount")
  dueDate    DateTime?  @map("due_date")
  status     DebtStatus @default(UNPAID)
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")
  dealer     Dealer     @relation(fields: [dealerId], references: [id])

  @@index([dealerId])
  @@map("dealer_debts")
}

model DealerOrder {
  id          String            @id @default(cuid())
  orderNumber String            @unique @map("order_number")
  dealerId    String            @map("dealer_id")
  staffId     String            @map("staff_id")
  vehicleId   String            @map("vehicle_id")
  quantity    Int
  unitPrice   Decimal           @map("unit_price")
  totalAmount Decimal           @map("total_amount")
  status      DealerOrderStatus @default(PENDING)
  orderedAt   DateTime          @default(now()) @map("ordered_at")
  confirmedAt DateTime?         @map("confirmed_at")
  shippedAt   DateTime?         @map("shipped_at")
  deliveredAt DateTime?         @map("delivered_at")
  notes       String?
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  dealer      Dealer            @relation(fields: [dealerId], references: [id])
  staff       User              @relation(fields: [staffId], references: [id])
  vehicle     Vehicle           @relation(fields: [vehicleId], references: [id])

  @@index([dealerId])
  @@index([staffId])
  @@index([vehicleId])
  @@map("dealer_orders")
}

model EVMInventory {
  id        String   @id @default(cuid())
  vehicleId String   @unique @map("vehicle_id")
  quantity  Int      @default(0)
  reserved  Int      @default(0)
  available Int      @default(0)
  location  String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId])
  @@map("evm_inventories")
}

model Inventory {
  id        String   @id @default(cuid())
  dealerId  String   @map("dealer_id")
  vehicleId String   @map("vehicle_id")
  quantity  Int      @default(0)
  reserved  Int      @default(0)
  sold      Int      @default(0)
  available Int      @default(0)
  location  String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  dealer    Dealer   @relation(fields: [dealerId], references: [id])
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id])

  @@unique([dealerId, vehicleId])
  @@index([dealerId])
  @@index([vehicleId])
  @@map("inventories")
}

model Quotation {
  id                String          @id @default(cuid())
  quoteNumber       String          @unique @map("quote_number")
  customerId        String          @map("customer_id")
  vehicleId         String          @map("vehicle_id")
  staffId           String          @map("staff_id")
  basePrice         Decimal         @map("base_price")
  discount          Decimal         @default(0)
  finalPrice        Decimal         @map("final_price")
  paymentType       PaymentType     @default(FULL) @map("payment_type")
  installmentMonths Int?            @map("installment_months")
  monthlyPayment    Decimal?        @map("monthly_payment")
  validUntil        DateTime        @map("valid_until")
  status            QuotationStatus @default(DRAFT)
  notes             String?
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  customer          Customer        @relation(fields: [customerId], references: [id])
  staff             User            @relation(fields: [staffId], references: [id])
  vehicle           Vehicle         @relation(fields: [vehicleId], references: [id])

  @@index([customerId])
  @@index([staffId])
  @@map("quotations")
}

model Contract {
  id                String         @id @default(cuid())
  contractCode      String         @unique @map("contract_code")
  customerId        String         @map("customer_id")
  staffId           String         @map("staff_id")
  vehicleId         String         @map("vehicle_id")
  basePrice         Decimal        @map("base_price")
  discount          Decimal        @default(0)
  finalPrice        Decimal        @map("final_price")
  paymentType       PaymentType    @default(FULL) @map("payment_type")
  installmentMonths Int?           @map("installment_months")
  monthlyPayment    Decimal?       @map("monthly_payment")
  interestRate      Decimal?       @map("interest_rate")
  status            ContractStatus @default(DRAFT)
  signedAt          DateTime?      @map("signed_at")
  deliveryDate      DateTime?      @map("delivery_date")
  deliveredAt       DateTime?      @map("delivered_at")
  notes             String?
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  complaints        Complaint[]
  customer          Customer       @relation(fields: [customerId], references: [id])
  staff             User           @relation(fields: [staffId], references: [id])
  vehicle           Vehicle        @relation(fields: [vehicleId], references: [id])
  customerDebts     CustomerDebt[]
  feedbacks         Feedback[]

  @@index([customerId])
  @@index([staffId])
  @@index([vehicleId])
  @@map("contracts")
}

model DealerDiscount {
  id            String       @id @default(cuid())
  dealerId      String       @map("dealer_id")
  name          String
  description   String?
  discountType  DiscountType @default(PERCENTAGE) @map("discount_type")
  discountValue Decimal      @map("discount_value")
  minPurchase   Decimal?     @map("min_purchase")
  startDate     DateTime     @map("start_date")
  endDate       DateTime?    @map("end_date")
  isActive      Boolean      @default(true) @map("is_active")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  dealer        Dealer       @relation(fields: [dealerId], references: [id])

  @@index([dealerId])
  @@index([isActive])
  @@map("dealer_discounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model User {
  id             String        @id @default(cuid())
  email          String        @unique
  hashedPassword String        @map("hashed_password")
  firstName      String?       @map("first_name")
  lastName       String?       @map("last_name")
  phone          String?
  role           UserRole      @default(DEALER_STAFF)
  isActive       Boolean       @default(true) @map("is_active")
  dealerId       String?       @map("dealer_id")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  contracts      Contract[]
  dealerOrders   DealerOrder[]
  quotations     Quotation[]
  sessions       Session[]
  testDrives     TestDrive[]
  dealer         Dealer?       @relation(fields: [dealerId], references: [id])

  @@index([dealerId])
  @@index([email])
  @@map("users")
}

model Manufacturer {
  id        String    @id @default(cuid())
  name      String    @unique
  code      String    @unique
  country   String
  logo      String?
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  vehicles  Vehicle[]

  @@map("manufacturers")
}

model Vehicle {
  id                String          @id @default(cuid())
  manufacturerId    String          @map("manufacturer_id")
  model             String
  variant           String?
  year              Int
  batteryCapacity   Int             @map("battery_capacity")
  range             Int
  chargingTime      Int?            @map("charging_time")
  motorPower        Int?            @map("motor_power")
  topSpeed          Int?            @map("top_speed")
  acceleration      Float?
  seats             Int             @default(5)
  doors             Int             @default(4)
  color             VehicleColor    @default(WHITE)
  bodyType          VehicleBodyType @default(SUV)
  wholesalePrice    Decimal         @map("wholesale_price")
  retailPrice       Decimal         @map("retail_price")
  currency          CurrencyCode    @default(USD)
  status            VehicleStatus   @default(ACTIVE)
  description       String?
  specifications    String?
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  contracts         Contract[]
  dealerOrders      DealerOrder[]
  evmInventories    EVMInventory?
  dealerInventories Inventory[]
  quotations        Quotation[]
  testDrives        TestDrive[]
  images            VehicleImage[]
  manufacturer      Manufacturer    @relation(fields: [manufacturerId], references: [id])

  @@index([manufacturerId])
  @@index([status])
  @@index([retailPrice])
  @@map("vehicles")
}

model VehicleImage {
  id        String  @id @default(cuid())
  vehicleId String  @map("vehicle_id")
  publicId  String? @map("public_id")
  url       String
  alt       String?
  blurhash  String?
  isMain    Boolean @default(false) @map("is_main")
  order     Int     @default(0)
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@map("vehicle_images")
}

enum CustomerStatus {
  INTERESTED
  CONTACTED
  TEST_DRIVE
  QUOTED
  PURCHASED
  COLD
}

enum TestDriveStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum FeedbackCategory {
  SERVICE
  PRODUCT
  DELIVERY
  OTHER
}

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum DealerContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
}

enum DebtStatus {
  UNPAID
  PARTIAL
  PAID
  OVERDUE
}

enum DealerOrderStatus {
  PENDING     // Chờ xác nhận
  CONFIRMED   // Đã xác nhận
  PROCESSING  // Đang xử lý
  SHIPPED     // Đang giao
  DELIVERED   // Đã giao
  CANCELLED   // Đã hủy
}

// Content from inventory.prisma
// ============================================
// INVENTORY MODELS - Quản lý tồn kho
// ============================================

// Tồn kho của Hãng xe (EVM)
model EVMInventory {
  id          String   @id @default(cuid())
  vehicleId   String   @map("vehicle_id")
  quantity    Int      @default(0)
  reserved    Int      @default(0) // Số lượng đã đặt bởi đại lý
  available   Int      @default(0) // quantity - reserved
  location    String?  // Kho
  
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([vehicleId])
  @@index([vehicleId])
  @@map("evm_inventories")
}

// Tồn kho tại Đại lý
model Inventory {
  id          String   @id @default(cuid())
  dealerId    String   @map("dealer_id")
  vehicleId   String   @map("vehicle_id")
  quantity    Int      @default(0)
  reserved    Int      @default(0) // Số lượng đã có khách đặt
  sold        Int      @default(0) // Số lượng đã bán
  available   Int      @default(0) // quantity - reserved - sold
  location    String?  // Vị trí trong showroom
  
  dealer      Dealer   @relation(fields: [dealerId], references: [id])
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([dealerId, vehicleId])
  @@index([dealerId])
  @@index([vehicleId])
  @@map("inventories")
}

// Content from order.prisma
// ============================================
// ORDER & SALES MODELS
// ============================================

// Báo giá
model Quotation {
  id          String          @id @default(cuid())
  quoteNumber String          @unique @map("quote_number")
  customerId  String          @map("customer_id")
  vehicleId   String          @map("vehicle_id")
  staffId     String          @map("staff_id")
  
  basePrice   Decimal         @map("base_price")
  discount    Decimal         @default(0)
  finalPrice  Decimal         @map("final_price")
  
  paymentType PaymentType     @default(FULL) @map("payment_type")
  installmentMonths Int?      @map("installment_months")
  monthlyPayment    Decimal?  @map("monthly_payment")
  
  validUntil  DateTime        @map("valid_until")
  status      QuotationStatus @default(DRAFT)
  notes       String?         @db.Text
  
  customer    Customer @relation(fields: [customerId], references: [id])
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])
  staff       User     @relation(fields: [staffId], references: [id])
  contracts   Contract[]
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([customerId])
  @@index([staffId])
  @@map("quotations")
}

// Hợp đồng bán hàng (Dealer → Customer)
model Contract {
  id              String         @id @default(cuid())
  contractCode    String         @unique @map("contract_code")
  customerId      String         @map("customer_id")
  staffId         String         @map("staff_id")
  vehicleId       String         @map("vehicle_id")
  quotationId     String?        @map("quotation_id")
  promotionId     String?        @map("promotion_id")
  
  basePrice       Decimal        @map("base_price")
  discount        Decimal        @default(0)
  finalPrice      Decimal        @map("final_price")
  
  paymentType     PaymentType    @default(FULL) @map("payment_type")
  installmentMonths Int?         @map("installment_months")
  monthlyPayment    Decimal?     @map("monthly_payment")
  interestRate      Decimal?     @map("interest_rate")
  
  status          ContractStatus @default(DRAFT)
  signedAt        DateTime?      @map("signed_at")
  deliveryDate    DateTime?      @map("delivery_date")
  deliveredAt     DateTime?      @map("delivered_at")
  
  notes           String?        @db.Text
  
  customer        Customer       @relation(fields: [customerId], references: [id])
  staff           User           @relation(fields: [staffId], references: [id])
  vehicle         Vehicle        @relation(fields: [vehicleId], references: [id])
  quotation       Quotation?     @relation(fields: [quotationId], references: [id])
  promotion       DealerDiscount? @relation(fields: [promotionId], references: [id])
  feedbacks       Feedback[]
  complaints      Complaint[]
  customerDebts   CustomerDebt[]
  
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  @@index([customerId])
  @@index([staffId])
  @@index([vehicleId])
  @@map("contracts")
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum ContractStatus {
  DRAFT
  PENDING
  SIGNED
  DELIVERING
  COMPLETED
  CANCELLED
}

enum PaymentType {
  FULL        // Trả thẳng
  INSTALLMENT // Trả góp
}


// Content from promotion.prisma
// ============================================
// PROMOTION MODELS - Khuyến mãi & Chiết khấu
// ============================================

model DealerDiscount {
  id          String              @id @default(cuid())
  dealerId    String              @map("dealer_id")
  name        String              // Tên chương trình
  description String?             @db.Text
  discountType DiscountType       @default(PERCENTAGE) @map("discount_type")
  discountValue Decimal           @map("discount_value") // % hoặc số tiền
  minPurchase  Decimal?           @map("min_purchase") // Giá trị đơn hàng tối thiểu
  
  // Source of promotion: DEALER (tự tạo) or MANUFACTURER (hãng cấp)
  source      PromotionSource     @default(DEALER)
  
  startDate   DateTime            @map("start_date")
  endDate     DateTime?           @map("end_date")
  isActive    Boolean             @default(true) @map("is_active")
  
  dealer      Dealer @relation(fields: [dealerId], references: [id])
  contracts   Contract[]
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([dealerId])
  @@index([isActive])
  @@index([source])
  @@map("dealer_discounts")
}

enum DiscountType {
  PERCENTAGE  // Chiết khấu theo %
  FIXED       // Chiết khấu cố định (VND/USD)
}

enum PromotionSource {
  DEALER        // Dealer tự tạo
  MANUFACTURER  // Hãng cấp cho dealer
}


// Content from session.prisma
// ============================================
// SESSION MODEL - Authentication
// ============================================

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  isActive     Boolean  @default(true) @map("is_active")
  
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("sessions")
}

// Content from user.prisma
// ============================================
// USER & AUTH MODELS
// ============================================

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  hashedPassword String    @map("hashed_password")
  firstName      String?   @map("first_name")
  lastName       String?   @map("last_name")
  phone          String?
  role           UserRole  @default(DEALER_STAFF)
  isActive       Boolean   @default(true) @map("is_active")
  
  dealerId       String?   @map("dealer_id")
  dealer         Dealer?   @relation(fields: [dealerId], references: [id])
  
  sessions       Session[]
  contracts      Contract[]
  dealerOrders   DealerOrder[]
  quotations     Quotation[]
  testDrives     TestDrive[]
  
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([dealerId])
  @@index([email])
  @@map("users")
}

