// ============================================
// VEHICLE MODELS - Xe điện mới
// ============================================

model Manufacturer {
  id          String    @id @default(cuid())
  name        String    @unique
  code        String    @unique
  country     String
  logo        String?
  isActive    Boolean   @default(true) @map("is_active")
  vehicles    Vehicle[]
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("manufacturers")
}

model Vehicle {
  id                String          @id @default(cuid())
  manufacturerId    String          @map("manufacturer_id")
  model             String
  variant           String?
  year              Int
  batteryCapacity   Int             @map("battery_capacity") // kWh
  range             Int             // km
  chargingTime      Int?            @map("charging_time") // minutes (0-80%)
  motorPower        Int?            @map("motor_power") // kW
  topSpeed          Int?            @map("top_speed") // km/h
  acceleration      Float?          // 0-100 km/h (seconds)
  seats             Int             @default(5)
  doors             Int             @default(4)
  color             VehicleColor    @default(WHITE)
  bodyType          VehicleBodyType @default(SUV)
  
  // Pricing
  wholesalePrice    Decimal         @map("wholesale_price") // Giá sỉ (EVM → Dealer)
  retailPrice       Decimal         @map("retail_price")    // Giá lẻ (Dealer → Customer)
  currency          CurrencyCode    @default(VND)
  
  status            VehicleStatus   @default(ACTIVE)
  description       String?         @db.Text
  specifications    String?         @db.Text // JSON string
  
  manufacturer      Manufacturer    @relation(fields: [manufacturerId], references: [id])
  images            VehicleImage[]
  evmInventories    EVMInventory[]
  dealerInventories Inventory[]
  dealerOrders      DealerOrder[]
  quotations        Quotation[]
  contracts         Contract[]
  testDrives  TestDrive[]
  vehicleUnits      VehicleUnit[]
  
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  @@index([manufacturerId])
  @@index([status])
  @@index([retailPrice])
  @@map("vehicles")
}

model VehicleImage {
  id        String  @id @default(cuid())
  vehicleId String  @map("vehicle_id")
  publicId  String? @map("public_id")  
  url       String
  alt       String?
  blurhash  String?
  isMain    Boolean @default(false) @map("is_main")
  order     Int     @default(0)
  
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@map("vehicle_images")
}

model VehicleUnit {
  id             String                 @id @default(cuid())
  vehicleId      String                 @map("vehicle_id")
  vin            String                 @unique
  engineNumber   String?                @map("engine_number")
  batterySerial  String?                @map("battery_serial")
  color          VehicleColor?
  status         VehicleUnitStatus      @default(IN_STOCK)
  storageType    VehicleUnitStorageType @default(EVM) @map("storage_type")
  dealerId       String?                @map("dealer_id")
  location       String?
  manufacturedAt DateTime?              @map("manufactured_at")
  importedAt     DateTime?              @map("imported_at")
  reservedAt     DateTime?              @map("reserved_at")
  deliveredAt    DateTime?              @map("delivered_at")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")
  createdById    String?                @map("created_by")
  updatedById    String?                @map("updated_by")

  vehicle        Vehicle                @relation(fields: [vehicleId], references: [id])
  dealer         Dealer?                @relation(fields: [dealerId], references: [id])
  contract       Contract?              @relation("ContractVehicleUnit")
  exportDocuments VehicleExportDocument[]
  createdBy      User?                  @relation("VehicleUnitCreatedBy", fields: [createdById], references: [id])
  updatedBy      User?                  @relation("VehicleUnitUpdatedBy", fields: [updatedById], references: [id])

  @@index([vehicleId])
  @@index([dealerId])
  @@index([status])
  @@map("vehicle_units")
}

model VehicleExportDocument {
  id               String               @id @default(cuid())
  code             String               @unique
  vehicleUnitId    String               @map("vehicle_unit_id")
  dealerId         String               @map("dealer_id")
  contractId       String?              @map("contract_id")
  status           ExportDocumentStatus @default(DRAFT)
  issuedAt         DateTime?            @map("issued_at")
  approvedAt       DateTime?            @map("approved_at")
  cancelledAt      DateTime?            @map("cancelled_at")
  recipientName    String?              @map("recipient_name")
  recipientPhone   String?              @map("recipient_phone")
  recipientId      String?              @map("recipient_id_number")
  recipientAddress String?              @map("recipient_address")
  notes            String?
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  createdById      String?              @map("created_by")
  approvedById     String?              @map("approved_by")
  cancelledById    String?              @map("cancelled_by")

  vehicleUnit      VehicleUnit          @relation(fields: [vehicleUnitId], references: [id])
  dealer           Dealer               @relation(fields: [dealerId], references: [id])
  contract         Contract?            @relation(fields: [contractId], references: [id])
  createdBy        User?                @relation("VehicleExportDocumentCreatedBy", fields: [createdById], references: [id])
  approvedBy       User?                @relation("VehicleExportDocumentApprovedBy", fields: [approvedById], references: [id])
  cancelledBy      User?                @relation("VehicleExportDocumentCancelledBy", fields: [cancelledById], references: [id])

  @@index([vehicleUnitId])
  @@index([dealerId])
  @@index([contractId])
  @@map("vehicle_export_documents")
}

enum VehicleColor {
  BLACK
  WHITE
  SILVER
  GREY
  RED
  BLUE
  GREEN
  YELLOW
  ORANGE
  BROWN
  GOLD
  BEIGE
  OTHER
}

enum VehicleBodyType {
  SEDAN
  SUV
  HATCHBACK
  COUPE
  WAGON
  VAN
  TRUCK
  OTHER
}

enum VehicleStatus {
  ACTIVE      // Đang bán
  INACTIVE    // Ngừng bán
  OUT_OF_STOCK // Hết hàng
}

enum VehicleUnitStatus {
  IN_STOCK
  RESERVED
  IN_TRANSIT
  DELIVERED
  RETURNED
  DAMAGED
}

enum VehicleUnitStorageType {
  EVM
  DEALER
  IN_TRANSIT
}

enum CurrencyCode {
  USD
  EUR
  GBP
  VND
}

enum ExportDocumentStatus {
  DRAFT
  APPROVED
  CANCELLED
}
