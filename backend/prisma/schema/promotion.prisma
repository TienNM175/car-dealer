
model DealerDiscount {
  id          String              @id @default(cuid())
  dealerId    String              @map("dealer_id")
  name        String             
  description String?             @db.Text
  discountType DiscountType       @default(PERCENTAGE) @map("discount_type")
  discountValue Decimal           @map("discount_value")
  minPurchase  Decimal?           @map("min_purchase") 
  
  source      PromotionSource     @default(DEALER)
  
  startDate   DateTime            @map("start_date")
  endDate     DateTime?           @map("end_date")
  isActive    Boolean             @default(true) @map("is_active")
  
  dealer      Dealer @relation(fields: [dealerId], references: [id])
  contracts   Contract[]
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([dealerId])
  @@index([isActive])
  @@index([source])
  @@map("dealer_discounts")
}

enum DiscountType {
  PERCENTAGE 
  FIXED      
}

enum PromotionSource {
  DEALER       
  MANUFACTURER
}
